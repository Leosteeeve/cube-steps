{
  "name": "cube-steps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "generate:cross": "node scripts/generate-cross-table.mts",
    "verify:cross": "node scripts/generate-cross-table.mts --verify",
    "generate:cases": "node scripts/generate-case-setups.mts",
    "verify:cases": "node scripts/generate-case-setups.mts --verify",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:corpus": "vitest run tests/solver-corpus.test.ts tests/color-input-corpus.test.ts tests/cfop-corpus.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:production": "node scripts/test-production.mjs",
    "notices": "node scripts/collect-notices.mjs",
    "format": "prettier --write src tests e2e scripts *.ts *.json .github/workflows"
  },
  "dependencies": {
    "cubing": "0.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
