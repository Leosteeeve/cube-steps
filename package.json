{
  "name": "cube-steps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:guide-video": "node scripts/tutorial/prepare-guide-video.mts",
    "predev": "npm run prepare:guide-video",
    "prebuild": "npm run prepare:guide-video",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "generate:cross": "node scripts/generate-cross-table.mts",
    "verify:cross": "node scripts/generate-cross-table.mts --verify",
    "generate:cases": "node scripts/generate-case-setups.mts",
    "verify:cases": "node scripts/generate-case-setups.mts --verify",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:roux": "vitest run src/methods/roux tests/roux-corner-coverage.test.ts tests/roux-stage-boundaries.test.ts --maxWorkers=1",
    "test:roux:coverage": "vitest run tests/roux-block-coverage.test.ts tests/roux-corner-coverage.test.ts tests/roux-lse-coverage.test.ts --maxWorkers=1",
    "test:roux:corpus": "vitest run tests/roux-corpus.test.ts tests/roux-color-input.test.ts --maxWorkers=1",
    "verify:roux": "node scripts/roux/build-block-policies.mts --verify && node scripts/roux/build-lse-policies.mts --verify",
    "test:corpus": "vitest run tests/solver-corpus.test.ts tests/color-input-corpus.test.ts tests/cfop-corpus.test.ts tests/advanced-cfop-corpus.test.ts --maxWorkers=1",
    "test:advanced": "vitest run src/methods/advanced src/algorithms src/practice tests/advanced-cross-table.test.ts tests/advanced-cfop-corpus.test.ts",
    "test:efficiency": "vitest run tests/advanced-efficiency.test.ts",
    "test:lab": "vitest run src/lab src/workers/lab-request.test.ts src/workers/lab-protocol.test.ts",
    "test:lab:corpus": "vitest run tests/lab-catalog.test.ts tests/lab-corpus.test.ts --maxWorkers=1",
    "test:lab:efficiency": "vitest run tests/lab-efficiency.test.ts",
    "benchmark:lab": "node scripts/benchmark-lab.mts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:production": "node scripts/test-production.mjs",
    "notices": "node scripts/collect-notices.mjs",
    "format": "prettier --write src tests e2e scripts *.ts *.json .github/workflows",
    "capture:guide": "node scripts/tutorial/capture-guide.mts",
    "verify:guide": "node scripts/tutorial/capture-guide.mts --verify"
  },
  "dependencies": {
    "cubing": "0.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
